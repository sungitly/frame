---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import {kind,featured,photos} from '../lib/data';
const months=[...new Set(featured.map(a=>a.date.slice(0,7)))];
---
<Layout title={kind==='frame'?'摄影书':'我们的相册'}>
{kind==='frame'?<div class="book-library">
  <header class="library-heading"><div><h1>摄影书</h1><p>把目光停留的地方，编成一本本书。</p></div><span>Sunlei · 2024</span></header>
  <section class="bookshelf" id="collections" aria-label="摄影书目录">
    {featured.map(book=><article class="book-item"><a class="book-cover" style={`--cloth:${book.color}`} href={`/albums/${book.id}/`} aria-label={`翻开《${book.title}》`}><div class="cover-type"><h2>{book.title}</h2><p>{book.subtitle}</p></div><div class="cover-photo"><Picture photo={book.cover} eager sizes="(max-width:600px) 80vw, 28vw"/></div><div class="cover-colophon"><span>PHOTOGRAPHS</span><span>SUNLEI</span></div></a><div class="book-label"><p>{book.description}</p><a href={`/albums/${book.id}/`}>翻开这本书 <span>{book.photos.length} 幅作品</span></a></div></article>)}
  </section>
  <p class="library-end">每一本书，都有自己的观看顺序。</p>
</div>:<div class="album-library">
  <header class="library-heading"><div><h1>我们的相册</h1><p>旅行、相聚，还有平常的一天。</p></div><div class="year-label">2024<span>{featured.length} 本相册 · {photos.length} 张照片</span></div></header>
  <nav class="month-index" aria-label="按月份浏览">{months.map(month=><a href={`#month-${month}`}>{Number(month.slice(5))} 月</a>)}</nav>
  <section id="collections">{months.map(month=><section class="month-group" id={`month-${month}`}><h2>{Number(month.slice(5))} 月 <span>2024</span></h2><div class="memory-albums">{featured.filter(a=>a.date.startsWith(month)).map(album=><a class="memory-album" href={`/albums/${album.id}/`}><div class="album-stack"><Picture photo={album.cover} sizes="(max-width:600px) 44vw, 23vw"/><span class="album-count">{album.photos.length} 张</span></div><h3>{album.title}</h3><p>{album.subtitle}</p></a>)}</div></section>)}</section>
</div>}
</Layout>
