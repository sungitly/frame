---
import '../styles/global.css';
import {kind, publishing} from '../lib/data';
const {title, description = kind==='frame' ? 'Sunlei 的自然与人文摄影集。' : '那些在一起的日子，Sunlei 的家庭影集。'} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · {kind==='frame' ? 'Frame / Sunlei' : 'Photo / Sunlei'}</title><meta name="description" content={description}/>{(!publishing || kind==='photo') && <meta name="robots" content="noindex, nofollow"/>}<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%232c382e'/%3E%3Cpath d='M18 48V16h29M18 31h23' stroke='%23f5f3ed' stroke-width='4' fill='none'/%3E%3C/svg%3E"/></head>
<body class={kind}>
  <a class="skip" href="#main">跳转到内容</a>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="返回首页">{kind==='frame' ? 'frame' : 'photo'}<span class="wordmark-dot">.</span></a>
    <nav aria-label="主导航"><a href="/#collections">{kind==='frame' ? '摄影系列' : '家庭相册'}</a><a href="/about/">{kind==='frame' ? '关于' : '关于影集'}</a>{!publishing && <a class="review-link" href="/review/">选片台</a>}{publishing && kind==='photo' && <a href="/cdn-cgi/access/logout">退出登录</a>}</nav>
  </header>
  <main id="main"><slot/></main>
  <footer class="site-footer"><a class="signature" href="/">Sunlei</a><p>{kind==='frame' ? '留住目光停下的地方。' : '把普通的日子，好好留下来。'}</p><a href="#main">回到顶部</a></footer>
  <dialog id="lightbox" aria-label="全屏看图">
    <div class="viewer-bar"><span id="viewer-count"></span><button id="viewer-close" aria-label="关闭全屏">关闭 <span aria-hidden="true">×</span></button></div>
    <img id="viewer-image" alt=""/><div class="viewer-bottom"><button id="viewer-prev" aria-label="上一张">上一张</button><p id="viewer-caption" aria-live="polite"></p><button id="viewer-next" aria-label="下一张">下一张</button></div>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#lightbox')!;
    const pictures = [...document.querySelectorAll<HTMLButtonElement>('[data-full]')];
    const image = document.querySelector<HTMLImageElement>('#viewer-image')!;
    const caption = document.querySelector('#viewer-caption')!;
    const count = document.querySelector('#viewer-count')!;
    let position = 0;
    function show(index: number) {
      position = (index + pictures.length) % pictures.length;
      const item = pictures[position];
      image.src = item.dataset.full!; image.alt = item.dataset.caption || '';
      caption.textContent = image.alt; count.textContent = `${position+1} / ${pictures.length}`;
    }
    pictures.forEach((button,index)=>button.addEventListener('click',()=>{show(index);dialog.showModal();document.body.style.overflow='hidden';}));
    dialog.addEventListener('close',()=>{document.body.style.overflow='';});
    document.querySelector('#viewer-close')?.addEventListener('click',()=>dialog.close());
    document.querySelector('#viewer-prev')?.addEventListener('click',()=>show(position-1));
    document.querySelector('#viewer-next')?.addEventListener('click',()=>show(position+1));
    dialog.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){e.preventDefault();show(position+1);} if(e.key==='ArrowLeft'){e.preventDefault();show(position-1);}});
    let startX=0;
    image.addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX;},{passive:true});
    image.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)>55)show(position+(dx<0?1:-1));},{passive:true});
  </script>
</body></html>
