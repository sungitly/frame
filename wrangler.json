{
  "name": "sunlei-frame",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/production",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "sunlei-frame-photos"
    }
  ],
  "routes": [
    {
      "pattern": "frame.sunlei.page",
      "custom_domain": true
    }
  ]
}
